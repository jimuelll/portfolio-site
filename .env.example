# Public HTTPS origin of the deployed site (used for SEO metadata).
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (visitor count + guestbook). Server-only: never prefix with NEXT_PUBLIC_.
# Create a free database at https://console.upstash.com and copy the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Guestbook moderation: send this exact word as a guestbook message to get delete buttons for that browser session.
# Server-only. Leave empty to turn moderation off.
GUESTBOOK_ADMIN_KEY=
