# Public HTTPS origin of the deployed site (used for SEO metadata).
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (visitor count + star log). Server-only: never prefix with NEXT_PUBLIC_.
# Either pair works. Vercel's Upstash integration creates the KV_ names for you; with Upstash directly, copy the REST
# URL and token from https://console.upstash.com into the UPSTASH_ names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Star log moderation: send this exact word as a message to get delete buttons for that browser session.
# Server-only. Leave empty to turn moderation off.
GUESTBOOK_ADMIN_KEY=
